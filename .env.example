# Copy this file to .env and fill in real values. .env is git-ignored.

# Which API *every* agent (Planner/Developer/Reviewer/GUI Tester) talks to --
# openai / anthropic / gemini / ollama. One switch for all four; only fill
# in the API key for whichever provider you pick (GUI Tester needs a
# vision-capable model on that provider -- see the *_MODEL notes below).
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Model per agent, interpreted against whichever LLM_PROVIDER is set above
# -- different agents can reasonably use different model sizes on the same
# provider. Examples per provider:
#   openai:    gpt-4.1
#   anthropic: claude-opus-5 (GUI_TESTER_MODEL needs vision + tool use)
#   gemini:    gemini-2.5-pro
#   ollama:    llama3.2-vision (GUI_TESTER_MODEL; any locally-pulled model
#              for the other three)
PLANNER_MODEL=gpt-4.1
DEVELOPER_MODEL=gpt-4.1
REVIEWER_MODEL=gpt-4.1
GUI_TESTER_MODEL=gpt-4.1

# Retry limits used by the orchestrator loop (design doc section 3/6)
MAX_DEV_REVIEW_RETRIES=5
MAX_GUI_RETRIES=5
MAX_REPLAN_ATTEMPTS=2
# Developer<->GUI Tester rewrite loop (separate counter from the
# Developer<->Reviewer loop above; tracked per-phase in state/plan.json)
MAX_GUI_TEST_RETRIES=4

# Debug only: skip Reviewer for one phase and inject a deliberate, visibly
# broken bug into the Developer's output before GUI verification, to demo
# the GUI-failure -> Developer-rewrite loop. Leave DEBUG_INJECT_BUG=false
# for normal runs.
DEBUG_INJECT_BUG=false
DEBUG_INJECT_PHASE_ID=
