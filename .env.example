# Copy this file to .env and fill in real values. .env is git-ignored.

# OpenAI API key shared by all four agents (Planner/Developer/Reviewer/GUITester)
OPENAI_API_KEY=

# Optional: override the model used per agent
PLANNER_MODEL=gpt-4.1
DEVELOPER_MODEL=gpt-4.1
REVIEWER_MODEL=gpt-4.1
GUI_TESTER_MODEL=gpt-4.1

# Retry limits used by the orchestrator loop (design doc section 3/6)
MAX_DEV_REVIEW_RETRIES=5
MAX_GUI_RETRIES=5
MAX_REPLAN_ATTEMPTS=2
